# Copy to .env and fill in your values. .env is git-ignored.

# Jira Cloud site, without trailing slash
JIRA_BASE_URL=https://your-site.atlassian.net

# Atlassian account email and API token
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_api_token

# Optional. Per-request timeout in milliseconds (default 30000)
# JIRA_TIMEOUT_MS=30000

# Optional. Log every Jira request to STDERR (method, path, status, duration)
# JIRA_DEBUG=1
